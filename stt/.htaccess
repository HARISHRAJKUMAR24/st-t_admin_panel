<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /stt/

    # IMPORTANT: If the request is for a real file or directory, don't rewrite
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Remove .php extension from URL (only for GET requests)
    RewriteCond %{THE_REQUEST} \s/+stt/(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^(.+)\.php$ /stt/$1 [R=301,L]

    # If request is not a file or folder, load .php automatically
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ $1.php [L,QSA]

    # Default homepage
    RewriteRule ^$ index.php [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "(config\.php|function\.php|\.env|\.htaccess|composer\.json|package\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable CORS for images (optional)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>